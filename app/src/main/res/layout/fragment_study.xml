<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">
    <!-- Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quizHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white"
            android:padding="12dp"
            android:src="@drawable/ic_cross"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnReset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:padding="10dp"
            android:src="@drawable/ic_rotate_right"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="@id/btnClose"
            app:tint="@color/text_secondary" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/study_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:indicatorColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintEnd_toStartOf="@id/tvCounter"
            app:layout_constraintStart_toEndOf="@id/btnReset"
            app:layout_constraintTop_toTopOf="@id/btnClose"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="10dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_soft_blue"
            android:fontFamily="@font/lexend_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="12/20"
            android:textColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnClose" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Card Container -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomController"
        app:layout_constraintTop_toBottomOf="@id/quizHeader">

        <!-- Card Front -->
        <include
            android:id="@+id/cardFront"
            layout="@layout/view_card_front" />
        <!-- Card Back -->
        <include
            android:id="@+id/cardBack"
            layout="@layout/view_card_back"
            android:visibility="gone" />
    </FrameLayout>

    <!-- منطقة التحكم الموحدة في أسفل الشاشة -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomController"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. منطقة الأكشن الأساسية (التي تتغير حسب الحالة) -->
        <FrameLayout
            android:id="@+id/interactionArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/navigation_row">

            <!-- وضع المراجعة: أزرار التقييم الثلاثة -->
            <LinearLayout
                android:id="@+id/review_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_missed"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFF1F2"
                    android:text="Hard"
                    android:textAllCaps="false"
                    android:textColor="#E11D48"
                    app:cornerRadius="16dp"
                    app:strokeColor="#FDA4AF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_good"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F0F9FF"
                    android:text="Good"
                    android:textAllCaps="false"
                    android:textColor="#0284C7"
                    app:cornerRadius="16dp"
                    app:strokeColor="#BAE6FD"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_got_it"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F0FDF4"
                    android:text="Easy"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    app:cornerRadius="16dp"
                    app:strokeColor="#BBF7D0"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- وضع الاختبار: منطقة الإدخال والتحقق -->
            <LinearLayout
                android:id="@+id/quiz_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/answerInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type answer here..."
                    app:boxCornerRadiusBottomEnd="20dp"
                    app:boxCornerRadiusBottomStart="20dp"
                    app:boxCornerRadiusTopEnd="20dp"
                    app:boxCornerRadiusTopStart="20dp"
                    app:boxStrokeErrorColor="@color/red"
                    app:boxStrokeColor="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/userAnswerEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/primary_blue"
                    android:fontFamily="@font/lexend_bold"
                    android:text="Check Answer"
                    app:elevation="4dp"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp" />

            </LinearLayout>
            <!-- منطقة الخطأ (تظهر عند الإجابة الخطأ فقط) -->
            <LinearLayout
                android:id="@+id/error_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="0.7"
                    android:text="Retry"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/primary_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_skip"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="@color/primary_blue"
                    android:text="Show Answer &amp; Skip"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. صف التنقل الثانوي (السابق / التالي) -->
        <LinearLayout
            android:id="@+id/navigation_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevCard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Previous"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_arrow_small_left"
                app:iconSize="20dp"
                app:iconTint="@color/text_secondary" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextCard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_arrow_small_right"
                app:iconGravity="textEnd"
                app:iconSize="20dp"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>