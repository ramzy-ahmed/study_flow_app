<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="button_background" parent="Widget.Material3.Button">
        <item name="backgroundTint">#0A1CE3</item>
        <item name="cornerRadius">25dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="DayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:layout_weight">1.1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="headTextCollapsed" parent="Widget.AppCompat.TextView">
        <item name="fontFamily"> @font/lexend_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="headTextExpended" parent="Widget.AppCompat.TextView">
        <item name="fontFamily"> @font/lexend_bold</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="subtitleTextCollapsed" parent="Widget.AppCompat.TextView">
        <item name="fontFamily"> @font/lexend_semi_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="subtitleTextExpended" parent="Widget.AppCompat.TextView">
        <item name="fontFamily"> @font/lexend_semi_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="bg_chip_green">
        <item name="android:background">@drawable/bg_rounded_green_alpha</item>
    </style>

    <!--  dialog style  -->
    <style name="CustomBottomSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyleContent</item>
    </style>

    <style name="CustomBottomSheetStyleContent" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="marginHorizontal">16dp</item>
    </style>

</resources>